# --- Servidor interno (la API publica habla con este servicio) ---
PORT=4000
NODE_ENV=development

# --- Motor de base de datos: sqlite | postgres | mysql ---
# sqlite usa node:sqlite (sin dependencias nativas) y el archivo DB_SQLITE_PATH
DB_ENGINE=sqlite
DB_SQLITE_PATH=./data/la-floresta-sur.sqlite

# PostgreSQL / PostGIS (Neon, Supabase, Render, docker-compose)
# DATABASE_URL=postgres://user:pass@host:5432/lafloresta
# DB_SSL=true

# MySQL (PlanetScale, Clever Cloud, docker-compose)
# DATABASE_URL=mysql://user:pass@host:3306/lafloresta

# --- Seguridad ---
# Clave compartida con la API para operaciones de escritura (CRUD)
ADMIN_API_KEY=cambia-esta-clave-en-produccion
# Origenes permitidos por CORS (separa con comas). * solo para demo publica
CORS_ORIGINS=*

# --- Opcional: IA generativa. Si esta vacio usa el agente deterministico ---
LLM_PROVIDER=
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini
